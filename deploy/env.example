# Copy to deploy/.env (gitignored) or /etc/packing-master/env (what install.sh writes).
DB_ROOT_PASS=change-me-root
DB_PASS=change-me
# Host port the app is published on.
HTTP_PORT=80
# Where MySQL data, backups and the update control files live on the host.
DATA_DIR=/var/lib/packing-master
TZ=Asia/Jerusalem
