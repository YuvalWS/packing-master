# Development database (in-cluster connection from app)
DB_HOST=db_dev
DB_PORT=3306
DB_USER=root
DB_PASS=devpassword
DB_NAME=packing_dev

# Test database (in-cluster connection from app)
DB_TEST_HOST=db_test
DB_TEST_PORT=3306
DB_TEST_USER=root
DB_TEST_PASS=testpassword
DB_TEST_NAME=packing_test

# Host-side port mappings (only used when connecting to MySQL from the host).
# Defaults are unusual on purpose to avoid clashing with an existing local MySQL.
DB_PORT_HOST=3316
DB_TEST_PORT_HOST=3317

# Host port the dev server is published on. Change it if the default collides
# with something else on the host — on Windows, Hyper-V reserves port ranges
# (check with: netsh int ipv4 show excludedportrange protocol=tcp).
APP_PORT_HOST=5173

# Path to source spreadsheet (used by extract:excel script).
# Mount the parent directory as a Docker volume so the container can read it.
PACKING_EXCEL_PATH=/data/source.xlsx
