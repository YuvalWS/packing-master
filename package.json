{
  "name": "packing-master",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/lib/db/migrate.ts dev",
    "db:migrate:test": "tsx src/lib/db/migrate.ts test",
    "seed:sample": "tsx src/lib/seed/cli.ts dev seed/sample",
    "seed:local": "tsx src/lib/seed/cli.ts dev seed/local",
    "seed:test": "tsx src/lib/seed/cli.ts test tests/fixtures",
    "extract:excel": "tsx src/lib/seed/extract-from-excel.ts"
  },
  "dependencies": {
    "@hebcal/core": "^5.4.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.5.0",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.11.0",
    "svelte": "^5.0.0",
    "umzug": "^3.8.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.16.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
